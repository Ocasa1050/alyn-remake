<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_120sdp"
    android:layout_height="@dimen/_108sdp"
    android:layout_margin="@dimen/_7sdp"
    android:background="@drawable/donate_cell_black_rounded"
    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

    <LinearLayout
        android:id="@+id/donate_cell_price_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/donate_cell_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/din_pro_medium"
            android:includeFontPadding="false"
            android:text="20,000"
            android:textColor="#eceff1"
            android:textSize="@dimen/_9sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/din_pro_medium"
            android:includeFontPadding="false"
            android:text="DH"
            android:textColor="#FFCA28"
            android:textSize="@dimen/_9sdp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/donate_cell_img"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_70sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:adjustViewBounds="true"
        android:maxWidth="@dimen/_125sdp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/donate_cell_price_layout" />

    <TextView
        android:id="@+id/donate_cell_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/din_pro_medium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:shadowColor="#FFFFFF"
        android:shadowRadius="2"
        android:text="Item name"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/donate_cell_img" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/donate_cell_my_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/donate_cell_black_rounded"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donate_cell_my_use_butt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:backgroundTint="#4caf50"
            android:text="Activate"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donate_cell_my_sell_butt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_25sdp"
            android:backgroundTint="#F4CB36"
            android:text="Sell"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/donate_cell_my_use_butt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donate_cell_my_cancel_butt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_25sdp"
            android:backgroundTint="#f44336"
            android:text="Cancel"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/donate_cell_my_sell_butt" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/donate_cell_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/donate_cell_black_rounded"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donate_cell_buy_butt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4caf50"
            android:text="Buy"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donate_cell_info_butt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_25sdp"
            android:backgroundTint="#03a9f4"
            android:text="Info"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/donate_cell_buy_butt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donate_cell_cancel_butt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_25sdp"
            android:backgroundTint="#f44336"
            android:text="Cancel"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/donate_cell_info_butt" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
